{
  "db_name": "PostgreSQL",
  "query": "SELECT b.id, b.name, c.icon, c.color, b.amount, b.due_day\n         FROM recurring_bills b JOIN categories c ON c.user_id = b.user_id AND c.id = b.category_id\n         WHERE b.user_id = $1 AND b.active AND b.archived_at IS NULL\n         ORDER BY b.due_day, lower(b.name), b.id",
