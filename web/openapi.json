{
  "openapi": "3.1.0",
  "info": {
    "title": "soldi",
    "description": "Personal-finance thermometer API. Authenticate with the `__Host-soldi_session` cookie (`soldi_session` over plain HTTP). Money is a decimal string. Errors are RFC 9457 `application/problem+json`.",
    "license": {
      "name": "AGPL-3.0-only",
      "identifier": "AGPL-3.0-only"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/api/auth/me": {
      "get": {
        "tags": [
          "auth"
        ],
        "operationId": "me",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/sign-in": {
      "post": {
        "tags": [
          "auth"
        ],
        "operationId": "sign_in",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Signed in; sets the session cookie",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "401": {
            "description": "`invalid-credentials`, the same for an unknown email and a wrong password",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited; wait `Retry-After` seconds",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/sign-out": {
      "post": {
        "tags": [
          "auth"
        ],
        "operationId": "sign_out",
        "responses": {
          "204": {
            "description": "Session revoked; cookie cleared"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/sign-up": {
      "post": {
        "tags": [
          "auth"
        ],
        "operationId": "sign_up",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignUp"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Signed up and signed in; sets the session cookie. Settings and default categories are created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "409": {
            "description": "`email-taken`",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited; wait `Retry-After` seconds",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/bills": {
      "get": {
        "tags": [
          "bills"
        ],
        "operationId": "list_bills",
        "responses": {
          "200": {
            "description": "Active recurring bills by due day, then name",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Bill"
                  }
                }
              }
            }
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/categories": {
      "get": {
        "tags": [
          "categories"
        ],
        "operationId": "list_categories",
        "responses": {
          "200": {
            "description": "Active categories: income, bills, then daily; by name within a kind",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Category"
                  }
                }
              }
            }
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "categories"
        ],
        "operationId": "create_category",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateCategory"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Category"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "An active category of the same kind has this name",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/categories/{id}": {
      "delete": {
        "tags": [
          "categories"
        ],
        "operationId": "archive_category",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Category id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Archived: it leaves the list, its entries keep it"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Missing, archived or another user's",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "categories"
        ],
        "operationId": "update_category",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Category id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateCategory"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "The category after the change; absent fields stay as they are",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Category"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Missing, archived or another user's",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "tags": [
          "health"
        ],
        "operationId": "health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/onboarding": {
      "post": {
        "tags": [
          "onboarding"
        ],
        "operationId": "complete_onboarding",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Onboarding"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Opening balance saved, bills created, `onboarded` is true",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "`already-onboarded`; nothing changes",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Fields named like `bills[0].amount`; nothing is saved",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/settings": {
      "get": {
        "tags": [
          "settings"
        ],
        "operationId": "get_settings",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Settings"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "settings"
        ],
        "operationId": "update_settings",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateSettings"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "The settings after the change; absent fields stay as they are",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Settings"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Money with more than two places, tiers out of order (names the upper tier of the first pair), goal outside 0..100",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Bill": {
        "type": "object",
        "description": "A recurring bill. `due_day` 29 to 31 falls on the last day of a shorter month.",
        "required": [
          "id",
          "category_id",
          "name",
          "amount",
          "due_day",
          "active"
        ],
        "properties": {
          "active": {
            "type": "boolean"
          },
          "amount": {
            "type": "string"
          },
          "category_id": {
            "type": "string",
            "format": "uuid"
          },
          "due_day": {
            "type": "integer",
            "format": "int32"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "Category": {
        "type": "object",
        "description": "`icon` is a lucide icon name; `color` a palette token, `cat-1` to `cat-12`.",
        "required": [
          "id",
          "name",
          "kind",
          "icon",
          "color"
        ],
        "properties": {
          "color": {
            "type": "string"
          },
          "icon": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "$ref": "#/components/schemas/CategoryKind"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "CategoryKind": {
        "type": "string",
        "enum": [
          "income",
          "bill",
          "daily"
        ]
      },
      "CreateBill": {
        "type": "object",
        "required": [
          "name",
          "amount",
          "due_day",
          "category_id"
        ],
        "properties": {
          "amount": {
            "type": "string",
            "description": "Greater than zero, up to two decimal places."
          },
          "category_id": {
            "type": "string",
            "format": "uuid",
            "description": "One of the caller's active `bill` categories."
          },
          "due_day": {
            "type": "integer",
            "format": "int32",
            "description": "1 to 31.",
            "maximum": 31,
            "minimum": 1
          },
          "name": {
            "type": "string",
            "description": "1 to 100 characters."
          }
        },
        "additionalProperties": false
      },
      "CreateCategory": {
        "type": "object",
        "description": "`icon` defaults to `circle-dashed`; `color` to the next token for the kind.",
        "required": [
          "name",
          "kind"
        ],
        "properties": {
          "color": {
            "type": [
              "string",
              "null"
            ]
          },
          "icon": {
            "type": [
              "string",
              "null"
            ]
          },
          "kind": {
            "$ref": "#/components/schemas/CategoryKind"
          },
          "name": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "FieldError": {
        "type": "object",
        "required": [
          "field",
          "message"
        ],
        "properties": {
          "field": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "Health": {
        "type": "object",
        "required": [
          "status",
          "version"
        ],
        "properties": {
          "status": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        }
      },
      "Onboarding": {
        "type": "object",
        "required": [
          "opening_balance",
          "opening_date"
        ],
        "properties": {
          "bills": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CreateBill"
            },
            "description": "Up to 50 recurring bills.",
            "maxItems": 50
          },
          "opening_balance": {
            "type": "string",
            "description": "What the user has today; may be negative."
          },
          "opening_date": {
            "type": "string",
            "format": "date"
          }
        },
        "additionalProperties": false
      },
      "Problem": {
        "type": "object",
        "description": "RFC 9457 problem details, the body of every error response.",
        "required": [
          "type",
          "title",
          "status",
          "detail"
        ],
        "properties": {
          "detail": {
            "type": "string"
          },
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldError"
            }
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        }
      },
      "Settings": {
        "type": "object",
        "description": "Money is a decimal string with up to two places (`\"-500.00\"`). The tiers are the lower\nbounds of the thermometer colors and are strictly increasing:\n`tier_red < tier_zero < tier_yellow < tier_green`.",
        "required": [
          "opening_balance",
          "opening_date",
          "tier_red",
          "tier_zero",
          "tier_yellow",
          "tier_green"
        ],
        "properties": {
          "opening_balance": {
            "type": "string"
          },
          "opening_date": {
            "type": "string",
            "format": "date"
          },
          "savings_goal_pct": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "0 to 100."
          },
          "tier_green": {
            "type": "string"
          },
          "tier_red": {
            "type": "string"
          },
          "tier_yellow": {
            "type": "string"
          },
          "tier_zero": {
            "type": "string"
          }
        }
      },
      "SignIn": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "SignUp": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string"
          },
          "name": {
            "type": [
              "string",
              "null"
            ],
            "description": "Defaults to the part of the e-mail before `@`."
          },
          "password": {
            "type": "string",
            "description": "8 to 128 characters."
          }
        },
        "additionalProperties": false
      },
      "UpdateCategory": {
        "type": "object",
        "description": "Absent fields stay as they are; the kind never changes.",
        "properties": {
          "color": {
            "type": [
              "string",
              "null"
            ]
          },
          "icon": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      },
      "UpdateSettings": {
        "type": "object",
        "description": "Absent fields stay as they are; `\"savings_goal_pct\": null` clears the goal.",
        "properties": {
          "opening_balance": {
            "type": [
              "string",
              "null"
            ]
          },
          "opening_date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "savings_goal_pct": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32"
          },
          "tier_green": {
            "type": [
              "string",
              "null"
            ]
          },
          "tier_red": {
            "type": [
              "string",
              "null"
            ]
          },
          "tier_yellow": {
            "type": [
              "string",
              "null"
            ]
          },
          "tier_zero": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      },
      "User": {
        "type": "object",
        "required": [
          "id",
          "email",
          "name",
          "onboarded"
        ],
        "properties": {
          "email": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "onboarded": {
            "type": "boolean",
            "description": "False until `POST /api/onboarding` runs; the web shows onboarding while it is false."
          }
        }
      }
    }
  }
}
